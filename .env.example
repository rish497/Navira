# Optional server-only route explanation. Never prefix secrets with VITE_.
YOLO_AUTO_API_KEY=
YOLO_AUTO_MODEL=qwen3.8-flash
# Optional vision-capable override for infrastructure image analysis.
# Falls back to YOLO_AUTO_MODEL when omitted.
YOLO_AUTO_VISION_MODEL=

# Optional fallback for another OpenAI-compatible provider.
OPENAI_API_KEY=

# Authentication secrets. Keep server-side and never prefix with VITE_.
# Use a long random value. Changing the pepper invalidates existing password hashes.
NAVIRA_AUTH_PEPPER=

# Optional comma-separated Open511 endpoints. When omitted, NAVIRA connects to
# the official DriveBC Open511 feed and clearly limits coverage to British Columbia.
NAVIRA_OPEN511_FEEDS=

# Optional comma-separated direct OASIS CAP XML/Atom/JSON feed endpoints supplied
# by the emergency-management jurisdictions using this deployment.
NAVIRA_CAP_FEEDS=
